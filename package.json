{
  "name": "tyler-tapia-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "content:validate": "tsx scripts/validate-content.ts",
    "prebuild": "npm run content:validate",
    "build": "next build",
    "test:release": "node scripts/smoke-release.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts .github *.json *.mjs *.ts",
    "format:check": "prettier --check src tests scripts .github *.json *.mjs *.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:browser": "playwright test",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "audit:performance": "node scripts/audit-performance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
